{
  "name": "med-manager-api",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:release-security": "node scripts/release-security-check.mjs",
    "cron:configure:missed-dose": "node scripts/configure-missed-dose-cron.mjs",
    "smoke:account-delete": "node scripts/account-delete-smoke.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.1",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.16.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "playwright": "^1.58.1",
    "prettier": "^3.9.4",
    "prisma": "^7.9.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "firebase-admin": "^14.2.0",
    "next": "^16.1.6",
    "pg": "^8.18.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  }
}
